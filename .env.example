# Copy to .env and fill in. Never commit .env.

# --- Discord (https://discord.com/developers/applications → your app → Bot) ---
DISCORD_TOKEN=
# Optional if the bot is only in one server. Right-click the server → Copy Server ID.
DISCORD_GUILD_ID=

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
# Every post is read by OPENAI_MODEL. Breaking news comes only from reporters' labels.
OPENAI_MODEL=gpt-6-luna
# low | medium | high | xhigh | max. Low keeps posts fast and cheap.
OPENAI_REASONING_EFFORT=low
# Let the model search the web about players (costs 1¢ per search; off is cheapest).
OPENAI_WEB_SEARCH=false
# Only needed if OPENAI_MODEL is a Claude model (name starts with claude-).
ANTHROPIC_API_KEY=

# --- X (https://console.x.com → your app → Keys and tokens → Bearer Token) ---
X_BEARER_TOKEN=
# Accounts to follow, comma-separated, without @.
X_ACCOUNTS=AdamSchefter,RapSheet,TomPelissero,JFowlerESPN,Schultz_Report
# stream = real-time filtered stream (falls back to poll automatically if unavailable)
# poll   = check recent search every X_POLL_SECONDS
X_MODE=stream
X_POLL_SECONDS=15
# After downtime, catch up on posts at most this old (0 = never catch up).
X_BACKFILL_MINUTES=30

# --- Discord layout (created automatically on first run) ---
DISCORD_CATEGORY_NAME=NFL News
SUBSCRIBE_CHANNEL_NAME=subscribe
# Admin-only channel showing what happened to every post and why. Leave empty to disable.
LOG_CHANNEL_NAME=newsbot-log
# Admin-only channel showing X and OpenAI credits left. Leave empty to disable.
CREDITS_CHANNEL_NAME=api-credits

# --- Dedup memory ---
STORY_WINDOW_HOURS=48
MAX_RECENT_STORIES=150
DB_PATH=data/nflnews.db
